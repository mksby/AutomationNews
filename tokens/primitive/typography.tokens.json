{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Space Grotesk", "system-ui", "-apple-system", "sans-serif"],
        "$description": "Body and UI"
      },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "monospace"],
        "$description": "Meta, labels, code"
      },
      "display": {
        "$value": ["Departure Mono", "JetBrains Mono", "ui-monospace", "monospace"],
        "$description": "Pixel display — headings/logo/decor only, never body"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    }
  },
  "size": {
    "$type": "dimension",
    "type": {
      "100": { "$value": "0.75rem", "$description": "12px — micro/meta" },
      "200": { "$value": "0.875rem", "$description": "14px — meta" },
      "300": { "$value": "1rem", "$description": "16px — body base" },
      "400": { "$value": "1.125rem", "$description": "18px — large body" },
      "500": { "$value": "1.25rem", "$description": "20px — h4/lead" },
      "600": { "$value": "1.5rem", "$description": "24px — h3" },
      "700": { "$value": "1.875rem", "$description": "30px — h2" },
      "800": { "$value": "2.5rem", "$description": "40px — h1" },
      "900": { "$value": "3.5rem", "$description": "56px — display" }
    },
    "display": {
      "100": {
        "$value": "1.375rem",
        "$description": "22px (2×11) — Departure pixel-snap"
      },
      "200": {
        "$value": "2.0625rem",
        "$description": "33px (3×11) — Departure pixel-snap"
      },
      "300": {
        "$value": "2.75rem",
        "$description": "44px (4×11) — Departure pixel-snap"
      }
    }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.1 },
    "snug": { "$value": 1.3 },
    "normal": { "$value": 1.55 },
    "relaxed": { "$value": 1.75 }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tight": { "$value": "-0.02em" },
    "normal": { "$value": "0em" },
    "wide": { "$value": "0.04em" },
    "label": { "$value": "0.08em" }
  }
}
